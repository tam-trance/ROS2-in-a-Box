#!/bin/bash
# Rename libraries in EXT_BUILD_DEPS if they exist with internal names
if [ -n "$EXT_BUILD_DEPS" ] && [ -d "$EXT_BUILD_DEPS/lib" ]; then
    if [ -f "$EXT_BUILD_DEPS/lib/libssl_internal.a" ]; then
        echo "Renaming libssl_internal.a to libssl.a"
        mv "$EXT_BUILD_DEPS/lib/libssl_internal.a" "$EXT_BUILD_DEPS/lib/libssl.a"
    fi
    if [ -f "$EXT_BUILD_DEPS/lib/libcrypto_internal.a" ]; then
        echo "Renaming libcrypto_internal.a to libcrypto.a"
        mv "$EXT_BUILD_DEPS/lib/libcrypto_internal.a" "$EXT_BUILD_DEPS/lib/libcrypto.a"
    fi
fi

# Execute the original configure script with all arguments
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ORIG_CONFIGURE="$DIR/configure.orig"
exec "$ORIG_CONFIGURE" "$@"
